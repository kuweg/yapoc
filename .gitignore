# ── Runtime data ─────────────────────────────────────────────────────────
# "data/*" rather than "data/" so the .gitkeep negation below actually works:
# git cannot re-include a file whose parent DIRECTORY is excluded.
data/*
!data/.gitkeep
**/data/sessions/
**/data/cron_runs.json
**/data/spawn_registry.*
**/data/poller_notified.*
**/data/notification_queue.*
**/data/notification_trace.jsonl
**/data/tickets.*

# Chat / conversation transcripts, wherever a runner decides to write them.
**/sessions/
**/events.jsonl
**/compaction_facts.jsonl
**/.outbox.jsonl

# Redis snapshot (if running redis-server in repo dir)
dump.rdb
*.rdb

# SQLite runtime databases (tickets, sessions, task state) — never source
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Frontend ─────────────────────────────────────────────────────────────
app/frontend/node_modules/
app/frontend/dist/
app/frontend/.vite/
app/frontend/tsconfig.tsbuildinfo

node_modules/
**/dist/
**/.vite/
**/.vite.log
*.tsbuildinfo
.pnpm-store/

# ── Agent runtime state (ephemeral — never source) ───────────────────────
# These patterns are deliberately UNANCHORED: a pattern with no slash matches a
# file of that name at ANY depth. The previous "app/agents/*/NAME" form only
# matched one level down, which is how app/backend/app/memory/agents/**/MEMORY.MD
# — a duplicate tree an agent created by mistake — reached git carrying real
# chat transcripts. Agents create directories in places we do not predict, so
# these rules key on the FILENAME, not on where it happens to live.
#
# Before adding a file here, check it is genuinely runtime state: PROMPT.MD,
# CONFIG.yaml, SYSTEM.md, CLAUDE.md and agent.py are source and must stay tracked.
MEMORY.MD
MEMORY.md
NOTES.MD
NOTES.md
LEARNINGS.MD
LEARNINGS.md
GOALS.MD
RESUME.MD
LIVE.MD
TASK.MD
STATUS.json
RESULT.MD
ERROR.MD
CRASH.MD
OUTPUT.MD
HEALTH.MD
HEALTH_SUMMARY.MD
SERVER_CRASH.MD
SERVER_OUTPUT.MD
SERVER_RESTART.MD
MORNING_REPORT.MD
MORNING_REPORT.md
REPORT.MD
AUDIT.MD
USAGE.json
COSTS.json
COSTS.lock
CHECKPOINT.json

# Agent-owned memory stores at any depth. The root store is app/memory/, but the
# nested-duplicate incident proved a prefix-anchored rule is not enough.
**/memory/agents/
**/memory/user/
**/memory/project/
**/agents/shared/
**/agents/concilium/

# Supervisor log / shell scratch that slipped past the patterns above:
app/agents/*/SUPERVISOR.MD
app/agents/*/.repl_history
app/agents/*/_diag_*.py

# Librarian consolidation reports — dated, regenerated each sweep.
app/agents/*/memory_consolidation_*.md

# One-off scratch files agents left in their own directories. Named
# individually on purpose: a blanket `app/agents/*/*.md` would swallow
# PROMPT.MD and CLAUDE.md, which are source.
app/agents/*/fix_task.md
app/agents/*/test-doc.md
app/agents/*/MCP_SMOKE_TEST.md
app/agents/*/prompt_structure.txt

# ── Layered memory store (app/memory/) ──────────────────────────────────
# THE live memory of the running system, and the reason this section exists:
# agents write here every turn via app/utils/tools/memory.py and
# app/agents/base/context.py. The rules above only ever covered the OLD
# app/agents/<name>/ layout, so after the memory refactor every MEMORY.MD /
# NOTES.MD / HEALTH.MD — plus the user's real name, location and interaction
# history under app/memory/user/ — was being committed on every run.
#
# All of it is runtime state, recreated on demand (every writer calls
# mkdir(parents=True, exist_ok=True) and every reader is _read_if_exists),
# so a fresh clone starts with an empty memory and fills it in itself.
#
# Written as "ignore the contents, re-include two seed files" rather than a
# blanket `app/memory/`: git never descends into an excluded DIRECTORY, so a
# plain `app/memory/` makes the `!` lines below unreachable and `git add` of a
# template fails. Each level has to be re-included before the level under it
# can be excluded again.
app/memory/*
!app/memory/user/
!app/memory/project/
app/memory/user/*
app/memory/project/*
# Seed templates stay tracked so a fresh clone can see the expected shape:
!app/memory/user/PROFILE.example.md
!app/memory/project/KNOWLEDGE.example.md

# Cross-agent knowledge bases — append-only runtime logs, not source.
app/agents/shared/KNOWLEDGE.MD
app/agents/shared/NEGATIVE_KNOWLEDGE.MD
app/agents/shared/NEGATIVE_KNOWLEDGE.md

# ── Skills ──────────────────────────────────────────────────────────────
# Hand-authored skills (git_commit.yaml, frontend_build.yaml, ...) are source
# and stay tracked. These two are not:
# NB: a `#` only starts a comment at the START of a line — a trailing one is
# part of the pattern, so these keep their comments above them.
#
# Per-skill success/failure counters.
app/skills/.health.json
# Auto-captured from live runs; the "summary" is a truncated frontmatter dump,
# which makes them useless as reusable skills.
app/skills/parent_id_*.yaml

# Quarantine / backup variants of runtime files
*.quarantine
*.MD.quarantine
*.MD.bak
*.MD.old

# Stray TASK.MD at the repo root (master runner writes its own elsewhere)
/TASK.MD

# Builder output workspace (agent-generated scratch)
projects/
app/projects/

# Concilium deliberation runtime: one dir per session, holds events.jsonl /
# LIVE.MD / result.json. Pure runtime output, not source.
app/agents/concilium/

# ── Personal notes ──────────────────────────────────────────────────────
personal_notes_do_not_read.md

# User and agent memory is local runtime state; never publish it. Listed as
# "app/memory/*" so the .example.md templates below can be re-included — the
# real PROFILE.md / KNOWLEDGE.md they are copied to stay ignored by the rules
# above.
app/memory/*
!app/memory/project/
!app/memory/user/
app/memory/project/*
app/memory/user/*
!app/memory/project/*.example.md
!app/memory/user/*.example.md

# Local scratch, generated state, and accidental root artifacts.
app/agents/*/.repl_history
app/agents/*/_diag_*.py
app/agents/*/fix_task.md
app/agents/*/prompt_structure.txt
app/agents/*/test-doc.md
app/agents/shared/
app/skills/.health.json
app/skills/parent_id_*.yaml
*.tsbuildinfo
/=1.1.0
/yapoc_chain.txt

# ── Test artifacts ──────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
artifacts/

# Debug / one-off test scripts at repo root.
# These MUST stay anchored with a leading "/". Without it git applies the
# pattern at every directory level, which silently ignored the whole real test
# suite — tests/ and app/backend/tests/ files were invisible to git, including
# tests for features that had already shipped.
/test.py
/test_*.py
app/test_*.py
# Agent scratch scripts, not a test suite.
app/projects/test_*.py
app/projects/*_test.py
app/test_*.txt
app/test_*.mp3
app/test_*.wav
app/check_*.py
app/yapoc_*.bin
app/yapoc_*.wav
app/yapoc_*.mp3

# ── Runtime ─────────────────────────────────────────────────────────────
.yapoc.pid

# Junk from redirected command output landing in the repo root
# (`=1.1.0` is a captured `poetry add` log; yapoc_chain.txt a smoke-test token).
/=*
/yapoc_chain.txt

# ── Editor / agent local state ──────────────────────────────────────────
.claude/
.codex
.codex/

# ── Playwright MCP snapshots / logs ─────────────────────────────────────
.playwright-mcp/

# Editor/agent backup files (only *.MD.bak was covered before)
*.bak

# Vite dev-server log — runtime output, never source
app/frontend/.vite.log

# pnpm content-addressable store — package cache, never source
.pnpm-store/
