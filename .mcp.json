{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--no-usage-statistics",
        "--isolated",
        "--viewport",
        "1280x720",
        "--executablePath",
        "${CHROME_PATH:-/usr/bin/chromium}"
      ]
    }
  }
}
